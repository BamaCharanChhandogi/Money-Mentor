# Server Port
PORT=5000

# Client URL (Frontend on Vercel or localhost)
CLIENT_URL=https://money-mentor-wheat.vercel.app

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ksbnq.mongodb.net/

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Google Apps Script Webhook (Port 443 HTTPS - works even when SMTP ports are blocked on Render free tier)
GOOGLE_MAILER_WEBHOOK=https://script.google.com/macros/s/AKfycby9Tlp4TcmzPFq0VJbSN7z24l2xJBsTUzIaRlFWNj7rTq8HIwcJwhK17otshwoMy80/exec

# Gmail / SMTP Direct Fallback
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_SERVICE=gmail
EMAIL_FROM="Money Mentor <your_email@gmail.com>"

# Plaid API Credentials
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transaction,identity
PLAID_COUNTRY_CODES=US,CA

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key
